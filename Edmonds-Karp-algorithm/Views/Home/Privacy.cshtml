@{
    // Layout = null;
    ViewData["Title"] = "TERMINAL // EDMONDS-KARP";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>TERMINAL // EDMONDS-KARP</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.26.0/cytoscape.min.js"></script>

    <style>
        :root {
            --bg-dark: #050505;
            --neon-cyan: #00f3ff;
            --neon-pink: #ff00ea;
            --neon-green: #39ff14;
            --neon-red: #ff2a2a;
            --grid-color: rgba(0, 243, 255, 0.07);
        }

        /* настройка базовых отступов для ASP.NET */
        body, html {
            margin: 0;
            padding: 0;
            height: 100vh;
            width: 100vw;
            background-color: var(--bg-dark);
            color: var(--neon-cyan);
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            overflow: hidden;
        }

        /* сайдбар */
        .cyber-sidebar {
            width: 320px;
            min-width: 320px;
            border-right: 2px solid var(--neon-cyan);
            background: #0a0a0a;
            display: flex;
            flex-direction: column;
            padding: 25px;
            box-sizing: border-box;
            z-index: 100;
        }

        h2 {
            font-size: 1.1rem;
            text-transform: uppercase;
            border-bottom: 2px solid var(--neon-cyan);
            padding-bottom: 10px;
            margin: 0 0 20px 0;
            letter-spacing: 2px;
            color: #fff;
        }

        .status-box {
            font-size: 0.85rem;
            margin-bottom: 20px;
            color: #888;
            background: rgba(0, 243, 255, 0.03);
            padding: 15px;
            border-left: 2px solid var(--neon-pink);
        }

        .status-box span { color: var(--neon-pink); font-weight: bold; }

        /* кнопки */
        .cyber-btn {
            background: transparent;
            color: var(--neon-cyan);
            border: 1px solid var(--neon-cyan);
            padding: 14px;
            margin-bottom: 12px;
            cursor: pointer;
            text-transform: uppercase;
            font-family: inherit;
            font-weight: bold;
            transition: 0.2s;
            text-align: left;
        }

        .cyber-btn:hover {
            background: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 20px var(--neon-cyan);
        }

        .btn-execute {
            margin-top: auto;
            border-color: var(--neon-pink);
            color: var(--neon-pink);
            text-align: center;
        }

        .btn-execute:hover {
            background: var(--neon-pink);
            color: #000;
            box-shadow: 0 0 20px var(--neon-pink);
        }

        /* контейнер графа */
        .viewport {
            flex-grow: 1;
            height: 100vh;
            position: relative;
            background-color: var(--bg-dark);
            /* сетка */
            background-image: 
                linear-gradient(var(--grid-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
            background-size: 50px 50px;
        }

        #cy {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 5;
            display: block;
        }

        /* модалка для JSON */
        #jsonModal {
            display: none;
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 70%; height: 70%;
            background: #050505;
            border: 2px solid var(--neon-pink);
            padding: 30px;
            z-index: 2000;
            flex-direction: column;
            box-shadow: 0 0 50px rgba(255, 0, 234, 0.3);
        }

        #jsonOutput {
            flex-grow: 1;
            background: #000;
            color: var(--neon-green);
            border: 1px dashed var(--neon-pink);
            padding: 15px;
            font-family: 'Consolas', monospace;
            font-size: 14px;
            resize: none;
            outline: none;
        }
    </style>
</head>
<body>

    <div class="cyber-sidebar">
        <h2>CMD // NODE_MANAGER</h2>
        <div class="status-box">
            > STATUS: ONLINE<br>
            > LINK: STABLE<br><br>
            > <span>1.</span> [INIT_NODE]<br>
            > <span>2.</span> SELECT 2 NODES FOR UPLINK<br>
            > <span>3.</span> DEFINE CAPACITY
        </div>

        <button class="cyber-btn" onclick="addNode()">> INIT_NEW_NODE();</button>
        <button class="cyber-btn" onclick="clearGraph()" style="color:var(--neon-red); border-color:var(--neon-red)">> PURGE_MEMORY();</button>
        
        <button class="cyber-btn btn-execute" onclick="generateJSON()">> COMPILE_AND_EXPORT();</button>
    </div>

    <div class="viewport">
        <div id="cy"></div>
    </div>

    <div id="jsonModal">
        <h2 style="color:var(--neon-pink); margin-top:0;">[ENCRYPTED_DATA_STREAM]</h2>
        <textarea id="jsonOutput" readonly></textarea>
        <div style="display:flex; gap:10px; margin-top:20px;">
            <button class="cyber-btn" style="flex-grow:1" onclick="document.getElementById('jsonModal').style.display='none'">> DISCONNECT</button>
        </div>
    </div>

    <script>
        let nodeIdCounter = 0;
        let firstSelectedNode = null;

        // инициализация Cytoscape
        var cy = cytoscape({
            container: document.getElementById('cy'),
            boxSelectionEnabled: false,
            autounselectify: false,
            style: [
                {
                    selector: 'node',
                    style: {
                        'shape': 'polygon',
                        'shape-polygon-points': '-0.7 -1, 0.7 -1, 1 -0.3, 1 0.3, 0.7 1, -0.7 1, -1 0.3, -1 -0.3', // Свой кастомный гексагон
                        'background-color': '#000',
                        'border-width': 3,
                        'border-color': '#00f3ff',
                        'label': 'data(id)',
                        'color': '#00f3ff',
                        'text-valign': 'center',
                        'text-halign': 'center',
                        'width': 60,
                        'height': 60,
                        'font-family': 'monospace',
                        'font-weight': 'bold',
                        'font-size': '18px'
                    }
                },
                {
                    selector: 'node.selected',
                    style: {
                        'border-color': '#ff00ea',
                        'color': '#ff00ea',
                        'background-color': 'rgba(255, 0, 234, 0.2)'
                    }
                },
                {
                    selector: 'node.source',
                    style: { 'border-color': '#39ff14', 'color': '#39ff14', 'border-width': 5 }
                },
                {
                    selector: 'node.sink',
                    style: { 'border-color': '#ff2a2a', 'color': '#ff2a2a', 'border-width': 5 }
                },
                {
                    selector: 'edge',
                    style: {
                        'width': 4,
                        'line-color': '#333',
                        'target-arrow-shape': 'triangle',
                        'target-arrow-color': '#00f3ff',
                        'curve-style': 'bezier',
                        'label': 'data(capacity)',
                        'color': '#ff00ea',
                        'font-size': '16px',
                        'font-weight': 'bold',
                        'text-background-color': '#050505',
                        'text-background-opacity': 1,
                        'text-background-padding': '4px',
                        'text-border-color': '#ff00ea',
                        'text-border-width': 1
                    }
                }
            ],
            layout: { name: 'preset' }
        });

        function addNode() {
           
            cy.resize(); 

            
            let extent = cy.extent();
            let xPos = extent.x1 + (extent.w / 2);
            let yPos = extent.y1 + (extent.h / 2);

            // добавляем узел с уникальным ID
            cy.add({
                group: 'nodes',
                data: { id: nodeIdCounter.toString() },
                position: { 
                    x: xPos + (Math.random() * 100 - 50), 
                    y: yPos + (Math.random() * 100 - 50) 
                }
            });

            nodeIdCounter++;
            updateSourceSinkStyles();
            
            // если нода первая — центрируем камеру
            if (cy.nodes().length === 1) {
                cy.center();
                cy.fit();
            }
        }

        // огика связей: Клик на А (выбор) -> Клик на B (создание)
        cy.on('tap', 'node', function(evt) {
            let node = evt.target;

            if (firstSelectedNode === null) {
                firstSelectedNode = node;
                node.addClass('selected');
                console.log("Node " + node.id() + " selected as Source");
            } else {
                if (firstSelectedNode.id() !== node.id()) {
                    let weight = prompt("SYSTEM_INPUT: ENTER EDGE CAPACITY", "10");
                    if (weight !== null && !isNaN(weight) && weight !== "") {
                        cy.add({
                            group: 'edges',
                            data: {
                                source: firstSelectedNode.id(),
                                target: node.id(),
                                capacity: parseInt(weight)
                            }
                        });
                        console.log("Edge created: " + firstSelectedNode.id() + " -> " + node.id());
                    }
                }
                firstSelectedNode.removeClass('selected');
                firstSelectedNode = null;
            }
        });

        //сброс при клике в пустоту
        cy.on('tap', function(evt) {
            if (evt.target === cy && firstSelectedNode) {
                firstSelectedNode.removeClass('selected');
                firstSelectedNode = null;
            }
        });

        function updateSourceSinkStyles() {
            cy.nodes().removeClass('source sink');
            let nodes = cy.nodes();
            if (nodes.length > 0) {
                //узел с ID "0" - Исток
                nodes.filter(n => n.id() === "0").addClass('source');
                
                //узел с самым большим ID - Сток
                if (nodes.length > 1) {
                    let maxId = -1;
                    let lastNode = null;
                    nodes.forEach(n => {
                        let id = parseInt(n.id());
                        if (id > maxId) { maxId = id; lastNode = n; }
                    });
                    if (lastNode) lastNode.addClass('sink');
                }
            }
        }

        function clearGraph() {
            if (confirm("SYSTEM_COMMAND: DELETE ALL TOPOLOGY DATA?")) {
                cy.elements().remove();
                nodeIdCounter = 0;
                firstSelectedNode = null;
            }
        }

        function generateJSON() {
            let nodes = cy.nodes();
            if (nodes.length < 2) return alert("CRITICAL_ERROR: INSUFFICIENT DATA NODES");

            let maxId = 0;
            nodes.forEach(n => maxId = Math.max(maxId, parseInt(n.id())));

            let data = {
                source: 0,
                sink: maxId,
                nodeCount: nodes.length,
                edges: cy.edges().map(e => ({
                    from: parseInt(e.data('source')),
                    to: parseInt(e.data('target')),
                    capacity: e.data('capacity')
                }))
            };

            document.getElementById('jsonOutput').value = JSON.stringify(data, null, 4);
            document.getElementById('jsonModal').style.display = 'flex';
        }

        
        window.addEventListener('resize', function() {
            cy.resize();
        });
    </script>
</body>
</html>